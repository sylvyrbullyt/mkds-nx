diff --git a/src/dolphin/CommonFuncs.cpp b/src/dolphin/CommonFuncs.cpp
index f85051d..70ac264 100644
--- a/src/dolphin/CommonFuncs.cpp
+++ b/src/dolphin/CommonFuncs.cpp
@@ -32,6 +32,10 @@ std::string LastStrerrorString()
 #if defined(__GLIBC__) && (_GNU_SOURCE || (_POSIX_C_SOURCE < 200112L && _XOPEN_SOURCE < 600))
   const char* str = strerror_r(errno, error_message, BUFFER_SIZE);
   return std::string(str);
+#elif defined(__SWITCH__)
+  // newlib on the Switch has no public strerror_r
+  (void)error_message;
+  return std::string(strerror(errno));
 #else
   int error_code = strerror_r(errno, error_message, BUFFER_SIZE);
   return error_code == 0 ? std::string(error_message) : "";
diff --git a/src/libretro/platform.cpp b/src/libretro/platform.cpp
index 3a4f6f6..4836fc4 100644
--- a/src/libretro/platform.cpp
+++ b/src/libretro/platform.cpp
@@ -1,4 +1,7 @@
 #include <cstdio>
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
 #include <cstring>
 #include <string>
 
@@ -203,6 +206,13 @@ namespace Platform
 
    void function_trampoline(void* param) {
       ThreadData* data = (ThreadData*)param;
+   #ifdef __SWITCH__
+      // libnx starts new threads on the process's default core (core 0),
+      // where the main thread already runs. melonDS's only worker is the
+      // software 3D renderer, so give it core 2 to itself; the frontend runs
+      // emulation on core 1 and the UI on core 0.
+      svcSetThreadCoreMask(CUR_THREAD_HANDLE, 2, 1u << 2);
+   #endif
       data->fn();
       delete data;
    }
